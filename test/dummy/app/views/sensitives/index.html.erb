<h1>Sensitive Page</h1>
<p class="message"><%= notice %></p>
<p>id: <%= @account.id %></p>
<p>password_hash digest: <%= @account.password_hash&.digest %></p>
<%# NOTE: Set to true if you want to test the behavior of creating related models with accounts#create. %>
<% if false %>
<p>nickname: <%= @account.user.nickname %></p>
<% end %>

<p><%= link_to "Authenticator app (TOTP)", aikotoba_scoped_path(:two_factor_totp_path) %></p>

<%= form_with method: :delete, url: aikotoba_scoped_path(:destroy_session_path) do |f| %>
  <%= f.submit 'Sign out' %>
<% end %>
